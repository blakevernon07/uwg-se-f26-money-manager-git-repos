<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.cs3211.moneymanager.controller.MainController">
   <children>
      <Button id="submitIncomeButton" fx:id="incomeButton" layoutX="180.0" layoutY="39.0" mnemonicParsing="false" onAction="#handleAddIncome" text="Submit Income" />
      <Button id="submitExpenseButton" fx:id="expenseButton" layoutX="178.0" layoutY="81.0" mnemonicParsing="false" onAction="#handleAddExpense" text="Submit Expense" />
      <ListView fx:id="expenseListView" layoutX="40.0" layoutY="200.0" prefHeight="264.0" prefWidth="417.0" />
      <Label fx:id="expenseListLabel" layoutX="40.0" layoutY="159.0" text="Log-">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <TextField fx:id="incomeTextField" layoutX="40.0" layoutY="39.0" prefHeight="25.0" prefWidth="112.0" promptText="Add Income" />
      <TextField fx:id="expensesTextField" layoutX="40.0" layoutY="81.0" prefHeight="25.0" prefWidth="112.0" promptText="Add Expense" />
      <Label fx:id="balanceTextField" layoutX="305.0" layoutY="42.0" text="Balance: ">
         <font>
            <Font size="13.0" />
         </font>
      </Label>
      <TextField fx:id="reasonTextField" layoutX="40.0" layoutY="122.0" prefHeight="25.0" prefWidth="188.0" promptText="Add Reason for expense/income" />
   </children>
</AnchorPane>
